# ============================================================
# Variáveis de ambiente — copie este arquivo para .env
# e preencha com suas credenciais reais.
# NUNCA versione o arquivo .env no repositório.
# ============================================================

# --- Supabase ---
# URL do projeto Supabase (Settings > API)
SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Chave anônima (leitura pública, usada no frontend)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave service_role (escrita/admin, usada APENAS no backend)
# NUNCA exponha esta chave no frontend ou em repositório público.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Portal da Transparência (opcional) ---
# Necessário apenas se usar endpoints autenticados da API
PORTAL_TRANSPARENCIA_API_KEY=SUA_CHAVE_AQUI

# --- Frontend (Vite) ---
# Repita a URL e a chave anônima com o prefixo VITE_ para o frontend
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
